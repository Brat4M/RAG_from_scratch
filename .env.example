# ─────────────────────────────────────────────────────────────────────────────
# RAG Engineering Academy — Environment Configuration Template
#
# Copy this file to .env and fill in values locally.
# NEVER commit .env to Git — it is listed in .gitignore.
# NEVER paste secret values into chat, notebooks, logs, or documentation.
# ─────────────────────────────────────────────────────────────────────────────

# Required only for notebooks that make real Groq API calls.
# Add your key to .env locally; leave this file blank.
GROQ_API_KEY=

# Optional: LangSmith tracing (used in Tracks 5–6 and 15).
# Tracing is OFF by default. Enable only after reading the privacy note in
# docs/setup-guide.md — tracing may transmit prompts and retrieved context
# to an external service.
#
# Note: verify which key name your LangSmith SDK version expects:
#   langsmith >= 0.1  →  LANGSMITH_API_KEY
#   older langchain integration  →  LANGCHAIN_API_KEY
# Document the exact mapping in docs/setup-guide.md before enabling.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-engineering-academy
LANGSMITH_TRACING=false

# Optional future provider keys — leave blank until a track requires them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application defaults
LLM_PROVIDER=groq
CHROMA_PERSIST_DIRECTORY=./storage/chroma
PROJECT_NAME=rag-engineering-academy
